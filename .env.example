NODE_ENV=development
PORT=4005

# Gateway client auth
GATEWAY_CLIENT_IDS=PROJECT_A,PROJECT_B
GATEWAY_CLIENT_SECRET_PROJECT_A=replace-with-project-a-secret
GATEWAY_CLIENT_SECRET_PROJECT_B=replace-with-project-b-secret

# Ollama Cloud inference and embeddings. The gateway rotates these keys for both.
OLLAMA_API_KEYS=key1,key2
OLLAMA_MODEL=gemma4:31b
OLLAMA_ALLOWED_MODELS=gemma4:31b
OLLAMA_EMBEDDING_MODEL=embeddinggemma
OLLAMA_EMBEDDING_ALLOWED_MODELS=embeddinggemma
