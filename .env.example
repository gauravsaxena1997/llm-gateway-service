NODE_ENV=development
PORT=4005
LLM_REQUEST_TIMEOUT_MS=120000

# Gateway client auth
GATEWAY_CLIENT_IDS=PROJECT_A,PROJECT_B
GATEWAY_CLIENT_SECRET_PROJECT_A=replace-with-project-a-secret
GATEWAY_CLIENT_SECRET_PROJECT_B=replace-with-project-b-secret

# Ollama Cloud inference. The gateway rotates these keys for generation and vision.
OLLAMA_API_KEYS=key1,key2
OLLAMA_MODEL=gemma4:31b
OLLAMA_ALLOWED_MODELS=gemma4:31b
OLLAMA_CLOUD_TRANSPORT=cloud-api
# Local Ollama embeddings. This model must be installed on the gateway host.
OLLAMA_LOCAL_BASE_URL=http://127.0.0.1:11434/api
OLLAMA_EMBEDDING_MODEL=embeddinggemma:300m-qat-q8_0
OLLAMA_EMBEDDING_ALLOWED_MODELS=embeddinggemma:300m-qat-q8_0
